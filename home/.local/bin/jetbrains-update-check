#!/usr/bin/env python3
"""Avisa cuando hay una versión nueva de un IDE de JetBrains instalado con Toolbox.

Toolbox no arranca con la sesión (consume ~500 MB y CPU en segundo plano) y los IDEs que instala
traen apagado su propio buscador de actualizaciones (-Dide.no.platform.update=true). Este script
lo reemplaza: una notificación por versión nueva, con un botón que abre Toolbox para actualizar.
Lo ejecuta jetbrains-update-check.timer al iniciar sesión y una vez por día.
"""
import json
import os
import subprocess
import sys
import urllib.request

HOME = os.path.expanduser("~")
APPS = f"{HOME}/.local/share/JetBrains/Toolbox/apps"
TOOLBOX = "/opt/jetbrains-toolbox/jetbrains-toolbox"
SETTINGS = f"{HOME}/.local/share/JetBrains/Toolbox/.settings.json"
AUTOSTART = f"{HOME}/.config/autostart/jetbrains-toolbox.desktop"
STATE = f"{os.environ.get('XDG_STATE_HOME', HOME + '/.local/state')}/cybersigil/jetbrains-notified.json"

# productCode de product-info.json → código del servicio de versiones de JetBrains
CODES = {"IU": "IIU", "IC": "IIC", "PY": "PCP", "PC": "PCC", "WS": "WS", "PS": "PS", "GO": "GO",
         "CL": "CL", "RD": "RD", "DB": "DG", "RM": "RM", "RR": "RR", "AI": "AI", "DS": "DS"}


def build(text):
    return tuple(int(x) for x in text.split(".") if x.isdigit())


def keep_autostart_off():
    """Si Toolbox volvió a activar su inicio automático, lo apaga otra vez."""
    try:
        with open(SETTINGS) as f:
            settings = json.load(f)
        if settings.get("autostart") is not False:
            settings["autostart"] = False
            with open(SETTINGS, "w") as f:
                json.dump(settings, f, indent=2)
    except (OSError, ValueError):
        pass
    if os.path.exists(AUTOSTART):
        os.remove(AUTOSTART)


def installed():
    ides = []
    for name in sorted(os.listdir(APPS)) if os.path.isdir(APPS) else []:
        try:
            with open(f"{APPS}/{name}/product-info.json") as f:
                info = json.load(f)
        except (OSError, ValueError):
            continue
        code = CODES.get(info.get("productCode"))
        if code:
            ides.append({"code": code, "name": info["name"], "version": info["version"], "build": info["buildNumber"]})
    return ides


def main():
    keep_autostart_off()
    ides = installed()
    if not ides:
        return
    url = ("https://data.services.jetbrains.com/products/releases?type=release&latest=true&code="
           + ",".join(sorted({i["code"] for i in ides})))
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            latest = json.load(r)
    except (OSError, ValueError):
        return  # sin red: se vuelve a intentar en la próxima ejecución

    try:
        with open(STATE) as f:
            notified = json.load(f)
    except (OSError, ValueError):
        notified = {}

    updates = []
    for ide in ides:
        release = (latest.get(ide["code"]) or [{}])[0]
        new_build = release.get("build", "")
        if new_build and build(new_build) > build(ide["build"]) and notified.get(ide["code"]) != new_build:
            updates.append((ide, release))
            notified[ide["code"]] = new_build
    if not updates:
        return

    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(notified, f)

    lines = [f"{ide['name']} {release['version']} (tienes {ide['version']})" for ide, release in updates]
    title = "Actualización disponible" if len(updates) == 1 else "Actualizaciones disponibles"
    # --action espera a que se cierre la notificación e imprime la acción elegida
    chosen = subprocess.run(
        ["notify-send", "--app-name=JetBrains Toolbox", "--icon=jetbrains-toolbox",
         "--action=open=Abrir Toolbox", title, "\n".join(lines)],
        capture_output=True, text=True).stdout.strip()
    if chosen == "open" and os.path.exists(TOOLBOX):
        subprocess.Popen([TOOLBOX], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    sys.exit(main())
