{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cybersigil",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "@@TEXT@@",
    "focusBorder": "@@ACCENT@@",
    "selection.background": "@@ACCENT@@80",
    "widget.border": "@@CHROME_DIM@@",
    "widget.shadow": "#00000099",
    "icon.foreground": "@@CHROME@@",
    "textLink.foreground": "@@ACCENT_SOFT@@",
    "textLink.activeForeground": "@@CHROME_HI@@",

    "titleBar.activeBackground": "@@BG@@",
    "titleBar.activeForeground": "@@TEXT@@",
    "titleBar.inactiveBackground": "@@BG@@",
    "titleBar.inactiveForeground": "@@CHROME_DIM@@",
    "titleBar.border": "@@SURFACE_HI@@",
    "menu.background": "@@SURFACE@@",
    "menu.foreground": "@@TEXT@@",
    "menu.selectionBackground": "@@ACCENT@@",
    "menu.separatorBackground": "@@CHROME_DIM@@",

    "activityBar.background": "@@BG@@",
    "activityBar.foreground": "@@CHROME_HI@@",
    "activityBar.inactiveForeground": "@@CHROME_DIM@@",
    "activityBar.activeBorder": "@@ACCENT_HI@@",
    "activityBar.border": "@@SURFACE_HI@@",
    "activityBarBadge.background": "@@ACCENT_HI@@",
    "activityBarBadge.foreground": "@@CHROME_HI@@",
    "badge.background": "@@ACCENT@@",
    "badge.foreground": "@@CHROME_HI@@",

    "sideBar.background": "@@BG_ALT@@",
    "sideBar.foreground": "@@TEXT@@",
    "sideBar.border": "@@SURFACE_HI@@",
    "sideBarTitle.foreground": "@@CHROME@@",
    "sideBarSectionHeader.background": "@@BG_ALT@@",
    "sideBarSectionHeader.foreground": "@@CHROME@@",
    "sideBarSectionHeader.border": "@@SURFACE_HI@@",
    "list.activeSelectionBackground": "@@SURFACE_HI@@",
    "list.activeSelectionForeground": "@@CHROME_HI@@",
    "list.inactiveSelectionBackground": "@@SURFACE@@",
    "list.hoverBackground": "@@SURFACE@@",
    "list.focusOutline": "@@ACCENT@@",
    "list.highlightForeground": "@@ACCENT_SOFT@@",
    "tree.indentGuidesStroke": "@@CHROME_DIM@@",

    "editorGroupHeader.tabsBackground": "@@BG@@",
    "editorGroupHeader.tabsBorder": "@@SURFACE_HI@@",
    "editorGroup.border": "@@SURFACE_HI@@",
    "tab.activeBackground": "@@BG@@",
    "tab.activeForeground": "@@CHROME_HI@@",
    "tab.activeBorderTop": "@@ACCENT_HI@@",
    "tab.inactiveBackground": "@@BG_ALT@@",
    "tab.inactiveForeground": "@@CHROME@@",
    "tab.border": "@@SURFACE_HI@@",
    "tab.hoverBackground": "@@SURFACE@@",
    "breadcrumb.foreground": "@@CHROME@@",
    "breadcrumb.focusForeground": "@@CHROME_HI@@",

    "editor.background": "@@BG@@",
    "editor.foreground": "@@TEXT@@",
    "editorCursor.foreground": "@@ACCENT_HI@@",
    "editor.lineHighlightBackground": "@@SURFACE@@",
    "editor.lineHighlightBorder": "@@SURFACE@@",
    "editor.selectionBackground": "@@ACCENT@@99",
    "editor.inactiveSelectionBackground": "@@ACCENT@@55",
    "editor.selectionHighlightBackground": "@@CHROME_DIM@@66",
    "editor.wordHighlightBackground": "@@CHROME_DIM@@55",
    "editor.findMatchBackground": "@@ACCENT_HI@@aa",
    "editor.findMatchHighlightBackground": "@@ACCENT@@66",
    "editorLineNumber.foreground": "@@CHROME_DIM@@",
    "editorLineNumber.activeForeground": "@@CHROME_HI@@",
    "editorIndentGuide.background1": "@@SURFACE_HI@@",
    "editorIndentGuide.activeBackground1": "@@CHROME_DIM@@",
    "editorWhitespace.foreground": "@@SURFACE_HI@@",
    "editorBracketMatch.background": "@@ACCENT@@55",
    "editorBracketMatch.border": "@@ACCENT_HI@@",
    "editorBracketHighlight.foreground1": "@@CHROME@@",
    "editorBracketHighlight.foreground2": "@@SYN_TYPE@@",
    "editorBracketHighlight.foreground3": "@@SYN_PROPERTY@@",
    "editorGutter.background": "@@BG@@",
    "editorGutter.addedBackground": "@@SYN_STRING@@",
    "editorGutter.modifiedBackground": "@@CHROME@@",
    "editorGutter.deletedBackground": "@@ACCENT_HI@@",
    "editorError.foreground": "@@ACCENT_SOFT@@",
    "editorWarning.foreground": "@@SYN_NUMBER@@",
    "editorInfo.foreground": "@@SYN_TYPE@@",
    "editorWidget.background": "@@SURFACE@@",
    "editorWidget.border": "@@CHROME_DIM@@",
    "editorSuggestWidget.background": "@@SURFACE@@",
    "editorSuggestWidget.selectedBackground": "@@SURFACE_HI@@",
    "editorSuggestWidget.highlightForeground": "@@ACCENT_SOFT@@",
    "editorHoverWidget.background": "@@SURFACE@@",
    "minimap.background": "@@BG@@",
    "scrollbarSlider.background": "@@CHROME_DIM@@55",
    "scrollbarSlider.hoverBackground": "@@CHROME_DIM@@99",
    "scrollbarSlider.activeBackground": "@@CHROME@@99",

    "input.background": "@@BG@@",
    "input.foreground": "@@TEXT@@",
    "input.border": "@@CHROME_DIM@@",
    "input.placeholderForeground": "@@CHROME_DIM@@",
    "inputOption.activeBorder": "@@ACCENT_HI@@",
    "dropdown.background": "@@SURFACE@@",
    "dropdown.border": "@@CHROME_DIM@@",
    "button.background": "@@ACCENT@@",
    "button.foreground": "@@CHROME_HI@@",
    "button.hoverBackground": "@@ACCENT_HI@@",
    "button.secondaryBackground": "@@SURFACE_HI@@",
    "button.secondaryForeground": "@@TEXT@@",
    "checkbox.background": "@@BG@@",
    "checkbox.border": "@@CHROME_DIM@@",
    "progressBar.background": "@@ACCENT_HI@@",
    "quickInput.background": "@@SURFACE@@",
    "quickInputList.focusBackground": "@@SURFACE_HI@@",
    "pickerGroup.foreground": "@@ACCENT_SOFT@@",

    "panel.background": "@@BG@@",
    "panel.border": "@@SURFACE_HI@@",
    "panelTitle.activeForeground": "@@CHROME_HI@@",
    "panelTitle.activeBorder": "@@ACCENT_HI@@",
    "panelTitle.inactiveForeground": "@@CHROME@@",
    "statusBar.background": "@@BG@@",
    "statusBar.foreground": "@@CHROME@@",
    "statusBar.border": "@@SURFACE_HI@@",
    "statusBar.debuggingBackground": "@@ACCENT@@",
    "statusBar.noFolderBackground": "@@BG@@",
    "statusBarItem.remoteBackground": "@@ACCENT@@",
    "statusBarItem.remoteForeground": "@@CHROME_HI@@",
    "statusBarItem.hoverBackground": "@@SURFACE_HI@@",
    "notifications.background": "@@SURFACE@@",
    "notifications.border": "@@CHROME_DIM@@",
    "notificationToast.border": "@@CHROME_DIM@@",

    "terminal.background": "@@BG@@",
    "terminal.foreground": "@@TEXT@@",
    "terminalCursor.foreground": "@@ACCENT_HI@@",
    "terminal.selectionBackground": "@@ACCENT@@99",
    "terminal.ansiBlack": "@@BG_ALT@@",
    "terminal.ansiBrightBlack": "@@CHROME_DIM@@",
    "terminal.ansiRed": "@@ACCENT@@",
    "terminal.ansiBrightRed": "@@ACCENT_SOFT@@",
    "terminal.ansiGreen": "#8a8f88",
    "terminal.ansiBrightGreen": "@@SYN_STRING@@",
    "terminal.ansiYellow": "#a89f91",
    "terminal.ansiBrightYellow": "@@SYN_NUMBER@@",
    "terminal.ansiBlue": "#7d8590",
    "terminal.ansiBrightBlue": "@@SYN_TYPE@@",
    "terminal.ansiMagenta": "#8e7d8a",
    "terminal.ansiBrightMagenta": "@@SYN_PROPERTY@@",
    "terminal.ansiCyan": "#86918f",
    "terminal.ansiBrightCyan": "#b0bcb9",
    "terminal.ansiWhite": "@@CHROME@@",
    "terminal.ansiBrightWhite": "@@CHROME_HI@@",

    "gitDecoration.addedResourceForeground": "@@SYN_STRING@@",
    "gitDecoration.modifiedResourceForeground": "@@SYN_NUMBER@@",
    "gitDecoration.deletedResourceForeground": "@@ACCENT_SOFT@@",
    "gitDecoration.untrackedResourceForeground": "@@SYN_TYPE@@",
    "gitDecoration.ignoredResourceForeground": "@@CHROME_DIM@@",
    "diffEditor.insertedTextBackground": "@@SYN_STRING@@22",
    "diffEditor.removedTextBackground": "@@ACCENT@@44"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "@@SYN_COMMENT@@", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "@@ACCENT_SOFT@@" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "@@CHROME@@" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "@@SYN_STRING@@" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "@@SYN_PROPERTY@@" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "@@SYN_NUMBER@@" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "@@CHROME_HI@@" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.java"],
      "settings": { "foreground": "@@SYN_TYPE@@" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "@@TEXT@@" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "@@TEXT@@", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "@@SYN_PROPERTY@@" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "@@ACCENT_SOFT@@", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "@@ACCENT_SOFT@@" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "@@SYN_PROPERTY@@" } },
    { "scope": ["entity.name.decorator", "meta.decorator", "storage.type.annotation", "punctuation.definition.annotation"],
      "settings": { "foreground": "@@SYN_NUMBER@@", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name.css", "support.type.property-name"], "settings": { "foreground": "@@SYN_PROPERTY@@" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "@@ACCENT_SOFT@@", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "@@SYN_TYPE@@" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "@@CHROME_HI@@", "background": "@@ACCENT@@" } }
  ],
  "semanticTokenColors": {
    "keyword": "@@ACCENT_SOFT@@",
    "class": "@@SYN_TYPE@@",
    "interface": { "foreground": "@@SYN_TYPE@@", "italic": true },
    "type": "@@SYN_TYPE@@",
    "enum": "@@SYN_TYPE@@",
    "enumMember": "@@SYN_NUMBER@@",
    "function": "@@CHROME_HI@@",
    "method": "@@CHROME_HI@@",
    "property": "@@SYN_PROPERTY@@",
    "variable": "@@TEXT@@",
    "variable.readonly": "@@SYN_NUMBER@@",
    "parameter": { "foreground": "@@TEXT@@", "italic": true },
    "decorator": { "foreground": "@@SYN_NUMBER@@", "italic": true },
    "string": "@@SYN_STRING@@",
    "number": "@@SYN_NUMBER@@",
    "comment": { "foreground": "@@SYN_COMMENT@@", "italic": true }
  }
}
