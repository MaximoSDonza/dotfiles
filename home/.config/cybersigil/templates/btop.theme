theme[available_end]="@@CHROME_HI@@"
theme[used_start]="@@CHROME@@"
theme[used_mid]="@@ACCENT@@"
theme[used_end]="@@ACCENT_HI@@"
theme[download_start]="@@CHROME_DIM@@"
theme[download_mid]="@@CHROME@@"
theme[download_end]="@@CHROME_HI@@"
