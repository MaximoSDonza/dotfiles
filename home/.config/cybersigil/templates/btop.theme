# Cybersigil — btop. Generado por cybersigil-apply
theme[main_bg]="@@BG@@"
theme[main_fg]="@@TEXT@@"
theme[title]="@@CHROME_HI@@"
theme[hi_fg]="@@ACCENT_HI@@"
theme[selected_bg]="@@ACCENT@@"
theme[selected_fg]="@@CHROME_HI@@"
theme[inactive_fg]="@@CHROME_DIM@@"
theme[graph_text]="@@CHROME@@"
theme[meter_bg]="@@SURFACE_HI@@"
theme[proc_misc]="@@CHROME@@"

# bordes cromados
theme[cpu_box]="@@CHROME@@"
theme[mem_box]="@@CHROME@@"
theme[net_box]="@@CHROME@@"
theme[proc_box]="@@CHROME@@"
theme[div_line]="@@CHROME_DIM@@"

# gradientes: gris oscuro -> cromo -> rojo sangre (más carga = más rojo)
theme[temp_start]="@@CHROME_DIM@@"
theme[temp_mid]="@@CHROME@@"
theme[temp_end]="@@ACCENT_HI@@"
