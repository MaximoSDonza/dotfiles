#!/usr/bin/env bash
# Frena el commit si lo que se va a subir parece contener secretos o archivos privados.
# Activado con: git config core.hooksPath .githooks (lo hace install.sh). Saltear: git commit --no-verify
set -euo pipefail
fail=0
patterns='(_authToken|api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|password\s*=|BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})'
while IFS= read -r -d '' f; do
  [[ $f == .githooks/pre-commit ]] && continue  # este archivo contiene los patrones a propósito
  case "$f" in
    *.npmrc|*.bashrc.local|*local.sh|*hosts.yml|*.env|*.pem|*.key|*id_rsa*|*id_ed25519*)
      echo "✗ archivo privado en el commit: $f"; fail=1; continue ;;
  esac
  if git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -qiE "$patterns"; then
    echo "✗ posible secreto en: $f"
    git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -iE "$patterns" | cut -c1-120 | sed 's/^/    /'
    fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)
(( fail )) && { echo "Commit frenado. Si es un falso positivo: git commit --no-verify"; exit 1; }
exit 0
